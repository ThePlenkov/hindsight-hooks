{
  "$schema": "https://nx.dev/reference/nx-schema",
  "plugins": [
    "./tools/nx-defaults.ts"
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsdown.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "check": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    }
  },
  "defaultBase": "main",
  "analytics": true
}